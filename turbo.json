{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "budget": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["STARTUP_BUDGET_MS"]
    },
    "@tiny-uptime/worker#test": {
      "dependsOn": ["^typecheck", "@tiny-uptime/panel#build"]
    },
    "@tiny-uptime/worker#budget": {
      "dependsOn": ["@tiny-uptime/panel#build"],
      "cache": false,
      "env": ["STARTUP_BUDGET_MS"]
    }
  }
}
