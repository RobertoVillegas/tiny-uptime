{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/routeTree.gen.ts", "**/dist/**", "**/.wrangler/**"],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag"]
      }
    ],
    "oxc/no-async-endpoint-handlers": "off"
  }
}
