{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiny-uptime",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-09-01",
  "minify": true,
  "keep_names": false,
  "workers_dev": true,
  "vars": { "PUBLIC_SLUG": "athas" },
  // The panel's build. Its hashed files under /app/assets are served straight from static assets;
  // everything else reaches the Worker, which answers /app/* with the panel's index.html.
  "assets": { "directory": "../panel/dist", "binding": "ASSETS", "run_worker_first": ["/*", "!/app/assets/*"] },
  "durable_objects": {
    // New code reaches every object right away, so a Worker never calls a method its objects lack yet.
    // Alarms survive the reset: one cut short is retried.
    "code_update_strategy": { "mode": "immediate" },
    "bindings": [
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "AUTH", "class_name": "AuthStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace", "Directory"], "deleted_classes": ["Hub"] },
    { "tag": "v3", "new_sqlite_classes": ["AuthStore"] },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
  },
}
