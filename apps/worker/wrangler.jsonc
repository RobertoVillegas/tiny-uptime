{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiny-uptime",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-09-01",
  "minify": true,
  "keep_names": false,
  "workers_dev": true,
  "vars": { "PUBLIC_SLUG": "roberto" },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "AUTH", "class_name": "AuthStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace", "Directory"], "deleted_classes": ["Hub"] },
    { "tag": "v3", "new_sqlite_classes": ["AuthStore"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  }
}
