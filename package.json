{
  "name": "tiny-uptime",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tiny-uptime/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:design": "node scripts/check-design.ts",
    "budget": "turbo run budget",
    "verify": "pnpm format && pnpm lint && pnpm check:boundaries && pnpm check:design && pnpm typecheck && pnpm test && pnpm budget",
    "deploy": "pnpm build && pnpm --filter @tiny-uptime/worker deploy",
    "e2e": "turbo run build --filter=@tiny-uptime/panel && pnpm --filter @tiny-uptime/panel e2e"
  },
  "devDependencies": {
    "oxc-parser": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.4",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.16.1"
}
